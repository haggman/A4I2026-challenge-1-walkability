{
  "$defs": {
    "CatchmentDemographics": {
      "additionalProperties": false,
      "properties": {
        "geo_id": {
          "title": "Geo Id",
          "type": "string"
        },
        "radius_m": {
          "default": 800.0,
          "title": "Radius M",
          "type": "number"
        },
        "tract_count": {
          "default": 1,
          "title": "Tract Count",
          "type": "integer"
        },
        "tract_geo_ids": {
          "items": {
            "type": "string"
          },
          "title": "Tract Geo Ids",
          "type": "array"
        },
        "total_pop": {
          "default": 0,
          "title": "Total Pop",
          "type": "integer"
        },
        "pop_65_plus": {
          "default": 0,
          "title": "Pop 65 Plus",
          "type": "integer"
        },
        "share_65_plus": {
          "default": 0.0,
          "title": "Share 65 Plus",
          "type": "number"
        },
        "households": {
          "default": 0,
          "title": "Households",
          "type": "integer"
        },
        "car_free_households": {
          "default": 0,
          "title": "Car Free Households",
          "type": "integer"
        },
        "no_vehicle_rate": {
          "default": 0.0,
          "title": "No Vehicle Rate",
          "type": "number"
        },
        "poverty_rate": {
          "default": 0.0,
          "title": "Poverty Rate",
          "type": "number"
        },
        "median_income": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Income"
        }
      },
      "required": [
        "geo_id"
      ],
      "title": "CatchmentDemographics",
      "type": "object"
    },
    "CityHeatFrequencySummary": {
      "additionalProperties": false,
      "properties": {
        "years_covered": {
          "default": "2019-2025",
          "title": "Years Covered",
          "type": "string"
        },
        "full_years_count": {
          "default": 7,
          "title": "Full Years Count",
          "type": "integer"
        },
        "avg_days_ge_90f": {
          "default": 78.0,
          "title": "Avg Days Ge 90F",
          "type": "number"
        },
        "avg_days_ge_95f": {
          "default": 23.9,
          "title": "Avg Days Ge 95F",
          "type": "number"
        },
        "avg_days_ge_100f": {
          "default": 1.6,
          "title": "Avg Days Ge 100F",
          "type": "number"
        },
        "hottest_temp_recorded_f": {
          "default": 104.0,
          "title": "Hottest Temp Recorded F",
          "type": "number"
        },
        "trend_days_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Days Per Decade"
        },
        "by_year": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "By Year",
          "type": "array"
        }
      },
      "title": "CityHeatFrequencySummary",
      "type": "object"
    },
    "Driver": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "description": "Feature column name from point_features().",
          "title": "Feature",
          "type": "string"
        },
        "attribution": {
          "description": "Signed \u00b0F contribution from ML.EXPLAIN_PREDICT vs. baseline.",
          "title": "Attribution",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "attribution"
      ],
      "title": "Driver",
      "type": "object"
    },
    "EquityAudit": {
      "additionalProperties": false,
      "properties": {
        "site_geo_ids": {
          "items": {
            "type": "string"
          },
          "title": "Site Geo Ids",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/EquityAuditMetricRow"
          },
          "title": "Metrics",
          "type": "array"
        },
        "ratios": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Ratios",
          "type": "object"
        },
        "deltas": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Deltas",
          "type": "object"
        },
        "passes_equity_check": {
          "title": "Passes Equity Check",
          "type": "boolean"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "site_geo_ids",
        "metrics",
        "ratios",
        "deltas",
        "passes_equity_check",
        "summary"
      ],
      "title": "EquityAudit",
      "type": "object"
    },
    "EquityAuditMetricRow": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "recommended_sites": {
          "title": "Recommended Sites",
          "type": "number"
        },
        "city_overall": {
          "title": "City Overall",
          "type": "number"
        },
        "ratio_rec_to_city": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio Rec To City"
        }
      },
      "required": [
        "metric",
        "recommended_sites",
        "city_overall"
      ],
      "title": "EquityAuditMetricRow",
      "type": "object"
    },
    "SiteAssessment": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "point_id": {
          "title": "Point Id",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "geo_id": {
          "title": "Geo Id",
          "type": "string"
        },
        "neighborhood": {
          "title": "Neighborhood",
          "type": "string"
        },
        "predicted_offset_f": {
          "title": "Predicted Offset F",
          "type": "number"
        },
        "campaign_mean_f": {
          "default": 82.1,
          "title": "Campaign Mean F",
          "type": "number"
        },
        "forecast_high_f": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast High F"
        },
        "forecast_implied_f": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast Implied F"
        },
        "priority_score": {
          "title": "Priority Score",
          "type": "number"
        },
        "unmeasured": {
          "title": "Unmeasured",
          "type": "boolean"
        },
        "spacing_conflict_with_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spacing Conflict With Rank"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "demographics": {
          "$ref": "#/$defs/CatchmentDemographics"
        },
        "hot_days": {
          "$ref": "#/$defs/SiteHotDays"
        },
        "google_maps_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Google Maps Url"
        },
        "google_maps_walking_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Google Maps Walking Url"
        },
        "why_here": {
          "title": "Why Here",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "point_id",
        "lat",
        "lon",
        "geo_id",
        "neighborhood",
        "predicted_offset_f",
        "priority_score",
        "unmeasured",
        "drivers",
        "demographics",
        "hot_days",
        "why_here"
      ],
      "title": "SiteAssessment",
      "type": "object"
    },
    "SiteHotDays": {
      "additionalProperties": false,
      "properties": {
        "city_days_ge_90f_per_yr": {
          "default": 78.0,
          "title": "City Days Ge 90F Per Yr",
          "type": "number"
        },
        "city_days_ge_95f_per_yr": {
          "default": 23.9,
          "title": "City Days Ge 95F Per Yr",
          "type": "number"
        },
        "city_days_ge_100f_per_yr": {
          "default": 1.6,
          "title": "City Days Ge 100F Per Yr",
          "type": "number"
        },
        "expected_days_ge_90f_equiv": {
          "default": 88.0,
          "title": "Expected Days Ge 90F Equiv",
          "type": "number"
        },
        "expected_days_ge_95f_equiv": {
          "default": 35.0,
          "title": "Expected Days Ge 95F Equiv",
          "type": "number"
        },
        "expected_days_ge_100f_equiv": {
          "default": 4.0,
          "title": "Expected Days Ge 100F Equiv",
          "type": "number"
        },
        "extra_days_ge_95f_equiv": {
          "default": 11.1,
          "title": "Extra Days Ge 95F Equiv",
          "type": "number"
        }
      },
      "title": "SiteHotDays",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The required challenge output artifact (`docs/contracts/placement_recommendation.schema.json`).",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "city": {
      "default": "Atlanta",
      "title": "City",
      "type": "string"
    },
    "track": {
      "default": "budget",
      "enum": [
        "today",
        "budget",
        "decade"
      ],
      "title": "Track",
      "type": "string"
    },
    "intervention": {
      "default": "3 permanent walkable cooling centers (This budget cycle)",
      "title": "Intervention",
      "type": "string"
    },
    "model_version": {
      "default": "offset_model_v1",
      "title": "Model Version",
      "type": "string"
    },
    "campaign_mean_f": {
      "default": 82.1,
      "title": "Campaign Mean F",
      "type": "number"
    },
    "sites": {
      "items": {
        "$ref": "#/$defs/SiteAssessment"
      },
      "title": "Sites",
      "type": "array"
    },
    "runner_up_sites": {
      "items": {
        "$ref": "#/$defs/SiteAssessment"
      },
      "title": "Runner Up Sites",
      "type": "array"
    },
    "heat_frequency": {
      "$ref": "#/$defs/CityHeatFrequencySummary"
    },
    "equity_audit": {
      "$ref": "#/$defs/EquityAudit"
    },
    "proposal_markdown": {
      "title": "Proposal Markdown",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "sites",
    "heat_frequency",
    "equity_audit",
    "proposal_markdown",
    "limitations"
  ],
  "title": "PlacementRecommendation",
  "type": "object"
}

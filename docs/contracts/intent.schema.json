{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "intent_type": {
      "enum": [
        "site_selection",
        "explain_location",
        "compare_sites",
        "heat_frequency",
        "demographics",
        "equity_audit",
        "out_of_scope_city",
        "causal_simulation",
        "future_forecast",
        "race_in_model",
        "ambiguous_prompt"
      ],
      "title": "Intent Type",
      "type": "string"
    },
    "city": {
      "default": "Atlanta",
      "title": "City",
      "type": "string"
    },
    "location_query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Query"
    },
    "lat": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lon"
    },
    "k_sites": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "K Sites",
      "type": "integer"
    },
    "min_spacing_m": {
      "default": 2000,
      "maximum": 10000,
      "minimum": 0,
      "title": "Min Spacing M",
      "type": "integer"
    },
    "radius_m": {
      "default": 800.0,
      "maximum": 5000.0,
      "minimum": 100.0,
      "title": "Radius M",
      "type": "number"
    },
    "forecast_high_f": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forecast High F"
    },
    "unmeasured_only": {
      "default": false,
      "title": "Unmeasured Only",
      "type": "boolean"
    },
    "compared_ranks": {
      "items": {
        "type": "integer"
      },
      "title": "Compared Ranks",
      "type": "array"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "clarification_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Question"
    },
    "refusal_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refusal Reason"
    }
  },
  "required": [
    "intent_type"
  ],
  "title": "Intent",
  "type": "object"
}

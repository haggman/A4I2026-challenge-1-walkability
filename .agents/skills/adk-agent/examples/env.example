# Copy to agent/heat_planner/.env (gitignored). Deployed values come from the deploy script.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Verify current GA model ids on the Gemini platform before setting these.
AGENT_MODEL=
WRITER_MODEL=

CITY=Dallas
TRACK=budget                 # today | budget | decade
BQ_LOCATION=US
DATA_DATASET=a4i_climate
ML_DATASET=a4i_ml
BQML_MODEL_ID=offset_model_v1
MAX_BYTES_BILLED=1000000000

TOOLBOX_URL=                 # https://heat-toolbox-xxxx.run.app  (empty = MCP toolset off)
MAPS_API_KEY=                # local dev only; deployed via Secret Manager

# Copy to agent/.env (gitignored) for local `adk web` / `adk run` / `pytest`.
# Never commit a real .env file.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-ec3596addc43
GOOGLE_CLOUD_LOCATION=us-central1
BQ_LOCATION=US

CITY=Atlanta
TRACK=budget
SCENARIO_SITES=3

BQML_MODEL_ID=offset_model_v1
AGENT_MODEL=gemini-2.5-flash
WRITER_MODEL=gemini-2.5-pro

# Optional: MCP Toolbox for Databases URL (local: http://localhost:5000, or Cloud Run URL)
TOOLBOX_URL=
TOOLBOX_TOOLSET=heat-planner

# Optional: Google Maps Geocoding API key (falls back to US Census Bureau Geocoder if unset)
MAPS_API_KEY=

# Per-query BigQuery safety cap (2 GiB)
MAX_BYTES_BILLED=2147483648
